# Compose-managed persistent FalkorDB used by Neuron.
FALKOR_HOST=localhost
FALKOR_PORT=6380
FALKOR_GRAPH=neuron

# Story demo source-of-truth and vector store. Start the local services with:
#   docker compose -f compose.story.yml up -d
# scripts/run_story_demo.sh points FALKOR_PORT at the isolated 6380 mapping.
DATABASE_URL=postgresql://neuron:neuron@localhost:55432/neuron
VECTOR_BACKEND=postgres
STORY_RELATED_EVIDENCE_LIMIT=5
STORY_RELATED_EVIDENCE_MIN_SCORE=0.55
STORY_RELATED_NODE_LIMIT=5
STORY_RELATED_NODE_MIN_SCORE=0.55
STORY_RUN_LLM=true
# Only this many semantically similar chunks that predate the current event
# are added to an extraction prompt. The complete graph is never sent.
STORY_RELATED_EVIDENCE_LIMIT=5
STORY_RELATED_EVIDENCE_MIN_SCORE=0.55

# Legacy connector deployments may still keep dense vectors in Qdrant. With
# VECTOR_BACKEND=postgres the same vector-store API uses pgvector instead.
# FalkorDB remains the rebuildable traversal/UI projection.
#   docker run -d --name qdrant -p 6333:6333 -v qdrant-storage:/qdrant/storage qdrant/qdrant
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=neuron_entities

# Used for LLM extraction/adjudication and answer synthesis only.
OPENAI_API_KEY=
# Embeddings run locally. Ingestion and retrieval must use the same model.
EMBEDDING_MODEL=BAAI/bge-m3
# Empty uses Apple MPS when available, otherwise CPU.
EMBEDDING_DEVICE=
# Empty uses a safe BGE-M3 micro-batch (4 on MPS, 8 on CPU). Set to override.
EMBEDDING_BATCH_SIZE=
EMBEDDING_MAX_TOKENS=8192
# Full source text stays in FalkorDB; this bounds only each dense-vector input.
EMBEDDING_WRITE_MAX_CHARS=4096
# Optional immutable Hugging Face revision for reproducible deployments.
EMBEDDING_MODEL_REVISION=
# LLM_MODEL = semantic extraction/adjudication for Jira, Notion and Bitbucket.
LLM_MODEL=gpt-5.6-luna
# CHAT_MODEL = answer synthesis.
CHAT_MODEL=gpt-5.6-sol

# Query-time relevance gate. "off" keeps the RRF + bounded-expansion path.
# Enabling "laya" requires the laya package in the runtime and a local
# checkpoint containing model.safetensors, questions.json and
# rl_agent_config.json. Thresholds must be tuned on Neuron's grouped dev set.
NEURON_RERANK=off
LAYA_MODEL_DIR=
LAYA_DEVICE=cpu
NEURON_RERANK_MIN_P=0.50
NEURON_RERANK_BRIDGE_MIN_P=0.20
NEURON_RERANK_BRIDGE_LIMIT=4
NEURON_RERANK_MIN_DIRECT=2
NEURON_RERANK_MAX_KEEP=12
NEURON_RERANK_MAX_ROUNDS=2
NEURON_RERANK_FACTS=6

# Ingestion-time cross-source linking. Every new/changed Jira, Notion, or
# Bitbucket chunk retrieves this many existing pgvector candidates, optionally
# reranks with Laya, and sends only the accepted top set to the extraction LLM.
# The LLM still has to select an exact candidate UID and pass evidence,
# identity, ontology, and direction validation before an edge is written.
# "off" skips only Laya and preserves vector shortlist + LLM validation.
NEURON_INGEST_RERANK=laya
NEURON_INGEST_CONTEXT_POOL=20
NEURON_INGEST_CONTEXT_TOP_K=7
NEURON_INGEST_CONTEXT_THRESHOLD=0.50

# Ingestion decision modes. Shadow/suggest preserve evidence and route
# uncertain changes through the review queue until eval/review precision
# satisfies 25-plan.md's promotion rules.
NEURON_TRIAGE=shadow
NEURON_RESOLVE_MODE=suggest
NEURON_FACT_UPDATE_MODE=suggest

# Answer path verification and nightly graph-health reporting.
NEURON_PATH_MIN=0.4
NEURON_HYGIENE_INTERVAL_S=86400

# Hard cap on LLM adjudication/extraction calls per sync run (plan.md §3, §4).
LLM_BUDGET_PER_RUN=200

# --- Jira OAuth (Phase 1 — first connector) ---
JIRA_OAUTH_CLIENT_ID=
JIRA_OAUTH_CLIENT_SECRET=
JIRA_OAUTH_REDIRECT_URI=http://localhost:8000/api/connectors/jira/oauth/callback
JIRA_TOKEN_ENCRYPTION_KEY=

# --- GitHub App connector (Phase 2) ---
GITHUB_APP_ID=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_APP_SLUG=
GITHUB_PRIVATE_KEY_PATH=.secrets/github-app-private-key.pem
GITHUB_OAUTH_CALLBACK_URL=http://localhost:8000/api/connectors/github/oauth/callback
GITHUB_MAX_FILE_KB=512
GITHUB_MAX_COMMITS_PER_SYNC=100

# --- Bitbucket OAuth (classic per-user grant, not an App installation) ---
BITBUCKET_OAUTH_CLIENT_ID=
BITBUCKET_OAUTH_CLIENT_SECRET=
BITBUCKET_OAUTH_REDIRECT_URI=http://localhost:8000/api/connectors/bitbucket/oauth/callback
BITBUCKET_TOKEN_ENCRYPTION_KEY=
BITBUCKET_MAX_FILE_BYTES=524288
BITBUCKET_MAX_COMMITS_PER_SYNC=100
# Keep requests sequential by default; Bitbucket recommends avoiding
# concurrency when its rolling API quota is under pressure.
BITBUCKET_API_CONCURRENCY=1
BITBUCKET_API_MIN_INTERVAL_SECONDS=0.25
BITBUCKET_MAX_REQUEST_INTERVAL_SECONDS=5
BITBUCKET_MAX_INLINE_RETRY_SECONDS=60

# --- Notion OAuth (Phase 3) ---
NOTION_OAUTH_CLIENT_ID=
NOTION_OAUTH_CLIENT_SECRET=
NOTION_OAUTH_REDIRECT_URI=http://localhost:8000/api/connectors/notion/oauth/callback
NOTION_TOKEN_ENCRYPTION_KEY=

# --- SharePoint / Microsoft Graph OAuth — out of scope for Phases 1-3 (plan.md §7) ---
# SHAREPOINT_CLIENT_ID=
# SHAREPOINT_CLIENT_SECRET=
# SHAREPOINT_TENANT_ID=
# SHAREPOINT_REDIRECT_URI=http://localhost:8000/api/connectors/sharepoint/oauth/callback
# SHAREPOINT_MAX_FILE_MB=25
